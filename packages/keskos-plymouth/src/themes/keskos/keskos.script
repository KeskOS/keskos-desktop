fun TextSprite(text, x, y, z, r, g, b) {
  image = Image.Text(text, r, g, b);
  sprite = Sprite();
  sprite.SetImage(image);
  sprite.SetX(x);
  sprite.SetY(y);
  sprite.SetZ(z);
  return sprite;
}

fun SetText(sprite, text, r, g, b) {
  sprite.SetImage(Image.Text(text, r, g, b));
}

