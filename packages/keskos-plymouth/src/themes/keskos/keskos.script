fun RefreshLog() {
  SetText(s01_ts, line01_ts, orange_r, orange_g, orange_b); SetText(s01_tag, line01_tag, orange_r, orange_g, orange_b); SetText(s01_msg, line01_msg, white_r, white_g, white_b);
  SetText(s02_ts, line02_ts, orange_r, orange_g, orange_b); SetText(s02_tag, line02_tag, orange_r, orange_g, orange_b); SetText(s02_msg, line02_msg, white_r, white_g, white_b);
