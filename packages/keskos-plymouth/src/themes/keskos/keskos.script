  SetText(s04_ts, line04_ts, orange_r, orange_g, orange_b); SetText(s04_tag, line04_tag, orange_r, orange_g, orange_b); SetText(s04_msg, line04_msg, white_r, white_g, white_b);
  SetText(s05_ts, line05_ts, orange_r, orange_g, orange_b); SetText(s05_tag, line05_tag, orange_r, orange_g, orange_b); SetText(s05_msg, line05_msg, white_r, white_g, white_b);
  SetText(s06_ts, line06_ts, orange_r, orange_g, orange_b); SetText(s06_tag, line06_tag, orange_r, orange_g, orange_b); SetText(s06_msg, line06_msg, white_r, white_g, white_b);
  SetText(s07_ts, line07_ts, orange_r, orange_g, orange_b); SetText(s07_tag, line07_tag, orange_r, orange_g, orange_b); SetText(s07_msg, line07_msg, white_r, white_g, white_b);
  SetText(s08_ts, line08_ts, orange_r, orange_g, orange_b); SetText(s08_tag, line08_tag, orange_r, orange_g, orange_b); SetText(s08_msg, line08_msg, white_r, white_g, white_b);
  SetText(s09_ts, line09_ts, orange_r, orange_g, orange_b); SetText(s09_tag, line09_tag, orange_r, orange_g, orange_b); SetText(s09_msg, line09_msg, white_r, white_g, white_b);
  SetText(s10_ts, line10_ts, orange_r, orange_g, orange_b); SetText(s10_tag, line10_tag, orange_r, orange_g, orange_b); SetText(s10_msg, line10_msg, white_r, white_g, white_b);
  SetText(s11_ts, line11_ts, orange_r, orange_g, orange_b); SetText(s11_tag, line11_tag, orange_r, orange_g, orange_b); SetText(s11_msg, line11_msg, white_r, white_g, white_b);
  SetText(s12_ts, line12_ts, orange_r, orange_g, orange_b); SetText(s12_tag, line12_tag, orange_r, orange_g, orange_b); SetText(s12_msg, line12_msg, white_r, white_g, white_b);
  SetText(s13_ts, line13_ts, orange_r, orange_g, orange_b); SetText(s13_tag, line13_tag, orange_r, orange_g, orange_b); SetText(s13_msg, line13_msg, white_r, white_g, white_b);
  SetText(s14_ts, line14_ts, orange_r, orange_g, orange_b); SetText(s14_tag, line14_tag, orange_r, orange_g, orange_b); SetText(s14_msg, line14_msg, white_r, white_g, white_b);
  cursor_sprite.SetX(line14_cursor);
  cursor_sprite.SetY(log_y + line_gap * 13);
}

fun PickIncoming(text) {
  incoming_ts = "";
  incoming_tag = "INIT";
  incoming_msg = text;
  incoming_cursor = msg_x + 480;

  if (text == "[00:00:00.000] KBI     Boot Interface v2.1 engaged") { incoming_ts = "[00:00:00.000]"; incoming_tag = "KBI"; incoming_msg = "Boot Interface v2.1 engaged"; incoming_cursor = msg_x + 250; }
  if (text == "[00:00:00.124] BOOT    KeskOS Bootloader v0.9.4") { incoming_ts = "[00:00:00.124]"; incoming_tag = "BOOT"; incoming_msg = "KeskOS Bootloader v0.9.4"; incoming_cursor = msg_x + 235; }
  if (text == "[00:00:00.251] BOOT    Verifying system integrity .............. OK") { incoming_ts = "[00:00:00.251]"; incoming_tag = "BOOT"; incoming_msg = "Verifying system integrity .............. OK"; incoming_cursor = msg_x + 425; }
  if (text == "[00:00:00.387] BOOT    Loading kernel image [keskos.core] ...... OK") { incoming_ts = "[00:00:00.387]"; incoming_tag = "BOOT"; incoming_msg = "Loading kernel image [keskos.core] ...... OK"; incoming_cursor = msg_x + 435; }
  if (text == "[00:00:00.621] KERNEL  Decompressing kernel ................... OK") { incoming_ts = "[00:00:00.621]"; incoming_tag = "KERNEL"; incoming_msg = "Decompressing kernel ................... OK"; incoming_cursor = msg_x + 390; }
  if (text == "[00:00:01.096] KERNEL  Initializing memory map ................. OK") { incoming_ts = "[00:00:01.096]"; incoming_tag = "KERNEL"; incoming_msg = "Initializing memory map ................. OK"; incoming_cursor = msg_x + 430; }
  if (text == "[00:00:01.280] KERNEL  ACPI subsystem ........................ OK") { incoming_ts = "[00:00:01.280]"; incoming_tag = "KERNEL"; incoming_msg = "ACPI subsystem ........................ OK"; incoming_cursor = msg_x + 395; }
  if (text == "[00:00:01.713] KERNEL  Scheduler initialized") { incoming_ts = "[00:00:01.713]"; incoming_tag = "KERNEL"; incoming_msg = "Scheduler initialized"; incoming_cursor = msg_x + 210; }
  if (text == "[00:00:02.341] DRIVER  Storage controller [NVMe0] .............. OK") { incoming_ts = "[00:00:02.341]"; incoming_tag = "DRIVER"; incoming_msg = "Storage controller [NVMe0] .............. OK"; incoming_cursor = msg_x + 430; }
  if (text == "[00:00:03.686] INIT    DISPLAY STACK ONLINE") { incoming_ts = "[00:00:03.686]"; incoming_tag = "INIT"; incoming_msg = "DISPLAY STACK ONLINE"; incoming_cursor = msg_x + 225; }
  if (text == "[00:00:03.921] INIT    SIGNAL LOCKED") { incoming_ts = "[00:00:03.921]"; incoming_tag = "INIT"; incoming_msg = "SIGNAL LOCKED"; incoming_cursor = msg_x + 155; }
  if (text == "[00:00:04.117] INIT    SPLIT INTERFACE ACTIVE") { incoming_ts = "[00:00:04.117]"; incoming_tag = "INIT"; incoming_msg = "SPLIT INTERFACE ACTIVE"; incoming_cursor = msg_x + 255; }
  if (text == "[00:00:04.417] INIT    SESSION HANDOFF READY") { incoming_ts = "[00:00:04.417]"; incoming_tag = "INIT"; incoming_msg = "SESSION HANDOFF READY"; incoming_cursor = msg_x + 250; }
  if (text == "[00:00:04.417] INIT    USER SESSION PENDING ...") { incoming_ts = "[00:00:04.417]"; incoming_tag = "INIT"; incoming_msg = "USER SESSION PENDING ..."; incoming_cursor = msg_x + 255; }
  if (text == "[00:00:04.417] INIT    SESSION HANDOFF PENDING ...") { incoming_ts = "[00:00:04.417]"; incoming_tag = "INIT"; incoming_msg = "SESSION HANDOFF PENDING ..."; incoming_cursor = msg_x + 285; }
  if (text == "[00:00:06.000] INIT    HANDOFF COMPLETE") { incoming_ts = "[00:00:06.000]"; incoming_tag = "INIT"; incoming_msg = "HANDOFF COMPLETE"; incoming_cursor = msg_x + 180; }
}

fun DisplayMessage(text) {
  if (text != "") {
    PickIncoming(text);
    line01_ts = line02_ts; line01_tag = line02_tag; line01_msg = line02_msg; line01_cursor = line02_cursor;
    line02_ts = line03_ts; line02_tag = line03_tag; line02_msg = line03_msg; line02_cursor = line03_cursor;
    line03_ts = line04_ts; line03_tag = line04_tag; line03_msg = line04_msg; line03_cursor = line04_cursor;
    line04_ts = line05_ts; line04_tag = line05_tag; line04_msg = line05_msg; line04_cursor = line05_cursor;
    line05_ts = line06_ts; line05_tag = line06_tag; line05_msg = line06_msg; line05_cursor = line06_cursor;
    line06_ts = line07_ts; line06_tag = line07_tag; line06_msg = line07_msg; line06_cursor = line07_cursor;
    line07_ts = line08_ts; line07_tag = line08_tag; line07_msg = line08_msg; line07_cursor = line08_cursor;
    line08_ts = line09_ts; line08_tag = line09_tag; line08_msg = line09_msg; line08_cursor = line09_cursor;
    line09_ts = line10_ts; line09_tag = line10_tag; line09_msg = line10_msg; line09_cursor = line10_cursor;
    line10_ts = line11_ts; line10_tag = line11_tag; line10_msg = line11_msg; line10_cursor = line11_cursor;
    line11_ts = line12_ts; line11_tag = line12_tag; line11_msg = line12_msg; line11_cursor = line12_cursor;
    line12_ts = line13_ts; line12_tag = line13_tag; line12_msg = line13_msg; line12_cursor = line13_cursor;
    line13_ts = line14_ts; line13_tag = line14_tag; line13_msg = line14_msg; line13_cursor = line14_cursor;
    line14_ts = incoming_ts; line14_tag = incoming_tag; line14_msg = incoming_msg; line14_cursor = incoming_cursor;
    RefreshLog();
  }
}

cursor_tick = 0;
cursor_state = 1;
scroll_tick = 0;
scroll_offset = 0;
uptime_tick = 0;
uptime_phase = 4;

fun RefreshCallback() {
  cursor_tick = cursor_tick + 1;
  scroll_tick = scroll_tick + 1;
  uptime_tick = uptime_tick + 1;

  if (cursor_tick > 16) {
    cursor_tick = 0;
    if (cursor_state == 1) {
      cursor_state = 0;
      cursor_sprite.SetImage(Image.Text("  ", orange_r, orange_g, orange_b));
    } else {
      cursor_state = 1;
      cursor_sprite.SetImage(Image.Text("[]", orange_r, orange_g, orange_b));
    }
  }

  if (scroll_tick > 10) {
    scroll_tick = 0;
    scroll_offset = scroll_offset + 10;
    if (scroll_offset > 116) {
      scroll_offset = 0;
    }
    scroll_thumb.SetY(scroll_top + 42 + scroll_offset);
  }

  if (uptime_tick > 24) {
    uptime_tick = 0;
    uptime_phase = uptime_phase + 1;
    if (uptime_phase > 9) {
      uptime_phase = 4;
    }
    if (uptime_phase == 4) { SetText(uptime_sprite, "UPTIME: 00:00:04", orange_r, orange_g, orange_b); }
    if (uptime_phase == 5) { SetText(uptime_sprite, "UPTIME: 00:00:05", orange_r, orange_g, orange_b); }
    if (uptime_phase == 6) { SetText(uptime_sprite, "UPTIME: 00:00:06", orange_r, orange_g, orange_b); }
    if (uptime_phase == 7) { SetText(uptime_sprite, "UPTIME: 00:00:07", orange_r, orange_g, orange_b); }
    if (uptime_phase == 8) { SetText(uptime_sprite, "UPTIME: 00:00:08", orange_r, orange_g, orange_b); }
    if (uptime_phase == 9) { SetText(uptime_sprite, "UPTIME: 00:00:09", orange_r, orange_g, orange_b); }
  }
}

Plymouth.SetDisplayMessageFunction(DisplayMessage);
Plymouth.SetRefreshFunction(RefreshCallback);
